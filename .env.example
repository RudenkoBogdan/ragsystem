# OpenRouter API key (get from https://openrouter.ai/keys)
ANTHROPIC_API_KEY=sk-or-v1-xxx

# Model to use (see https://openrouter.io/models)
# Examples:
#   anthropic/claude-3-5-sonnet
#   anthropic/claude-3-5-haiku
#   anthropic/claude-3-opus
#   openai/gpt-4-turbo
#   google/gemini-2.0-flash-exp
CLAUDE_MODEL=anthropic/claude-3-5-sonnet

# --- LLM provider ---
# "openrouter" (cloud, default) or "ollama" (local models)
LLM_PROVIDER=openrouter

# Ollama settings (used when LLM_PROVIDER=ollama, or selected per-user in Settings).
# Inside Docker, localhost is auto-rewritten to host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

JWT_SECRET=change-me-to-a-random-secret-string

# Backend Docker build - choose CPU or GPU version
# CPU (default, lightweight, ~5 min build): Dockerfile.cpu
# GPU (with CUDA, ~20+ min build): Dockerfile.gpu
BACKEND_DOCKERFILE=Dockerfile.cpu

# --- Security ---------------------------------------------------------------
# JWT_SECRET above must be replaced with at least 32 random characters, e.g.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# The backend now refuses to start while it is still the placeholder value.

# Local-development escape hatch from that boot check. NEVER set this in a
# deployed environment: while it is false, tokens cannot be signed with the
# publicly readable default.
ALLOW_INSECURE_JWT_SECRET=false

# Whether a user-supplied LLM base_url may point at loopback, link-local or
# private addresses. false blocks the server being aimed at internal services.
LLM_ALLOW_PRIVATE_HOSTS=false

# Comma-separated list of browser origins allowed by CORS. Add your own
# deployment's origin here; "*" is only allowed when credentials are off.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Allow cookies/Authorization on cross-origin requests. Keep false unless you
# have listed your exact origins above; browsers reject "*" with credentials.
CORS_ALLOW_CREDENTIALS=false

# Root log level for the application's `ragapp` logger: DEBUG, INFO, WARNING,
# ERROR or CRITICAL. An unknown value falls back to INFO.
LOG_LEVEL=INFO

# Login throttle, per account (N attempts per W seconds). Bounds the argon2
# CPU-burn and offline-cracking oracles.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW=60

# Login throttle, per source IP. Catches one host spraying many accounts.
AUTH_LOGIN_IP_RATE_LIMIT=30
AUTH_LOGIN_IP_RATE_WINDOW=60

# Registration throttle, per source IP.
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW=300
