# OpenRouter API key (get from https://openrouter.ai/keys)
ANTHROPIC_API_KEY=sk-or-v1-xxx

# Model to use (see https://openrouter.io/models)
# Examples:
#   anthropic/claude-3-5-sonnet
#   anthropic/claude-3-5-haiku
#   anthropic/claude-3-opus
#   openai/gpt-4-turbo
#   google/gemini-2.0-flash-exp
CLAUDE_MODEL=anthropic/claude-3-5-sonnet

JWT_SECRET=change-me-to-a-random-secret-string

# Backend Docker build - choose CPU or GPU version
# CPU (default, lightweight, ~5 min build): Dockerfile.cpu
# GPU (with CUDA, ~20+ min build): Dockerfile.gpu
BACKEND_DOCKERFILE=Dockerfile.cpu
