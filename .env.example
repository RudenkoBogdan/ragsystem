# OpenRouter API key (get from https://openrouter.ai/keys)
ANTHROPIC_API_KEY=sk-or-v1-xxx

# Model to use (see https://openrouter.io/models)
# Examples:
#   anthropic/claude-3-5-sonnet
#   anthropic/claude-3-5-haiku
#   anthropic/claude-3-opus
#   openai/gpt-4-turbo
#   google/gemini-2.0-flash-exp
CLAUDE_MODEL=anthropic/claude-3-5-sonnet

# --- LLM provider ---
# "openrouter" (cloud, default) or "ollama" (local models)
LLM_PROVIDER=openrouter

# Ollama settings (used when LLM_PROVIDER=ollama, or selected per-user in Settings).
# Inside Docker, localhost is auto-rewritten to host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# --- Latency / speed tuning ---
# Fewer chunks + shorter history + smaller context = faster first token on CPU.
RAG_TOP_K=5              # retrieved chunks per query (lower = shorter prompt)
RAG_CHUNK_CHAR_LIMIT=1200  # max chars per chunk in the prompt (0 = no cap)
CHAT_HISTORY_LIMIT=6     # past messages kept as context
LLM_MAX_TOKENS=1024      # cap on generated tokens
LLM_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE=24h    # keep model in RAM (avoids reload on each request)
OLLAMA_NUM_CTX=4096      # Ollama context window

JWT_SECRET=change-me-to-a-random-secret-string

# Encryption key for users' stored OpenRouter keys (Fernet, 32 url-safe base64 bytes).
# Empty = derived from JWT_SECRET (rotating JWT_SECRET then invalidates stored keys).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_KEY=
